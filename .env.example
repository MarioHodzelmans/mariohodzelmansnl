DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=https://mariohodzelmans.nl

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: set to false for a local Postgres instance that does not use SSL.
# DATABASE_SSL=false

# Optional: set to false if you want to manage Payload schema changes manually.
# PAYLOAD_DB_PUSH=false

# Optional: set to false if you do not want Payload to create starter blog posts.
# PAYLOAD_SEED_BLOGS=false
